{
  "name": "@yourdigitaltoolbox/pi-context-lifecycle",
  "version": "0.1.0",
  "description": "Process-local lifecycle coordination for safe Pi context compaction and resume.",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "scripts": {
    "clean": "rm -rf dist coverage test-results build-artifacts",
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run test/registry.test.ts test/coordinator.test.ts test/harness.test.ts",
    "test:integration": "vitest run test/extension.test.ts",
    "test:real-session": "vitest run --config vitest.real.config.ts",
    "test:git-install-omit-dev": "vitest run test/git-install-omit-dev.test.ts",
    "test:packaged-smoke": "npm run build && node scripts/run-packaged-smoke.ts",
    "test:candidate": "npm run build && npm run test:real-session && node scripts/run-packaged-smoke.ts",
    "test:exact-candidate": "npm run build && node scripts/run-exact-candidate.ts",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "ci": "npm run check && npm run test:real-session && node scripts/run-packaged-smoke.ts && npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@types/node": "^22.17.0",
    "typebox": "1.1.38",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourdigitaltoolbox/pi-context-lifecycle.git"
  },
  "bugs": {
    "url": "https://github.com/yourdigitaltoolbox/pi-context-lifecycle/issues"
  },
  "homepage": "https://github.com/yourdigitaltoolbox/pi-context-lifecycle#readme"
}
